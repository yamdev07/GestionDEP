// Schéma de base de données — MonBudget (revenus & dépenses)
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Type d'une opération : une entrée d'argent (revenu) ou une sortie (dépense).
enum TransactionType {
  INCOME
  EXPENSE
}

/// Fréquence d'une opération récurrente (fonction Premium).
enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

/// Type de compte / portefeuille.
enum AccountType {
  CASH // Espèces
  MOBILE_MONEY // Wave, Orange Money, MoMo…
  BANK // Compte bancaire
  OTHER // Autre
}

/// Plan d'abonnement (ordre croissant : Gratuit < Essentiel < Premium).
enum Plan {
  GRATUIT
  ESSENTIEL
  PREMIUM
}

/// Cycle de facturation.
enum BillingCycle {
  MENSUEL
  ANNUEL
}

/// Statut d'une période d'abonnement.
enum SubStatus {
  ACTIVE
  EXPIRED
  CANCELED
}

/// Statut d'un paiement FedaPay.
enum PaymentStatus {
  PENDING
  APPROVED
  CANCELED
}

/// Un utilisateur. Chaque utilisateur ne voit QUE ses propres données.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  currency     String    @default("XOF") // devise affichée (XOF, XAF, EUR, USD, ...)
  plan         Plan      @default(GRATUIT) // plan payant en cours
  planUntil    DateTime? // le plan payant reste actif tant que cette date est future
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  categories    Category[]
  transactions  Transaction[]
  budgets       Budget[]
  accounts      Account[]
  savingsGoals  SavingsGoal[]
  subscriptions Subscription[]
  payments      Payment[]
  recurrings    RecurringTransaction[]

  pushSubscriptions  PushSubscription[]
  alertNotifications AlertNotification[]
  budgetPeriods      BudgetPeriod[]
}

/// Snapshot d'un budget de catégorie pour un mois clôturé (archive + report).
/// Auto-suffisant (nom/couleur figés) : conservé même si la catégorie est supprimée.
model BudgetPeriod {
  id            String   @id @default(cuid())
  userId        String
  categoryId    String
  categoryName  String
  categoryColor String   @default("#6366f1")
  categoryIcon  String   @default("tag")
  period        String // "YYYY-MM" — mois couvert par ce snapshot
  budgetCents   Int // plafond EFFECTIF du mois (base + report entrant)
  spentCents    Int // dépensé réel du mois (figé à la clôture)
  rolloverCents Int      @default(0) // report SORTANT vers le mois suivant (budget - spent)
  closedAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, period])
  @@index([userId])
  @@index([userId, period])
}

/// Abonnement Web Push d'un appareil/navigateur (pour les notifications d'alerte).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String // clé publique du client (chiffrement)
  auth      String // secret d'authentification du client
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Trace d'une alerte de budget déjà notifiée, pour ne pas renotifier en boucle.
/// Une ligne par (utilisateur, catégorie, mois, niveau).
model AlertNotification {
  id         String   @id @default(cuid())
  userId     String
  categoryId String
  period     String // "YYYY-MM" (mois concerné)
  level      String // "NEAR" (>=80%) ou "OVER" (>=100%)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, period, level])
  @@index([userId])
}

/// Historique des abonnements : une ligne par activation / renouvellement / changement.
model Subscription {
  id         String       @id @default(cuid())
  userId     String
  plan       Plan         @default(ESSENTIEL)
  cycle      BillingCycle
  priceCents Int
  startedAt  DateTime     @default(now())
  endsAt     DateTime
  status     SubStatus    @default(ACTIVE)
  note       String       @default("") // ex: "Payé (FedaPay)", "Activé par l'admin"
  createdAt  DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Paiement FedaPay (réconciliation de l'activation d'un abonnement).
model Payment {
  id          String        @id @default(cuid())
  userId      String
  plan        Plan
  cycle       BillingCycle
  amountCents Int
  fedapayId   String? // id de la transaction FedaPay
  status      PaymentStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([fedapayId])
}

/// Objectif d'épargne : ce que l'utilisateur met de côté, avec un but optionnel.
model SavingsGoal {
  id          String    @id @default(cuid())
  name        String
  color       String    @default("#6d28d9")
  targetCents Int       @default(0) // objectif (0 = pas de cible, épargne libre)
  savedCents  Int       @default(0) // montant déjà mis de côté
  deadline    DateTime? // date cible optionnelle
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Un compte / portefeuille (Espèces, Mobile Money, Banque…) avec son solde.
model Account {
  id                  String      @id @default(cuid())
  name                String
  type                AccountType @default(CASH)
  color               String      @default("#6d28d9") // couleur d'affichage
  initialBalanceCents Int         @default(0) // solde de départ (centimes)
  userId              String
  createdAt           DateTime    @default(now())

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  recurrings   RecurringTransaction[]

  @@unique([userId, name])
  @@index([userId])
}

/// Catégorie, personnalisable par utilisateur (utilisée par les dépenses).
model Category {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#6366f1") // couleur hex pour les graphiques
  icon      String   @default("tag") // nom d'icône lucide (kebab-case)
  userId    String
  createdAt DateTime @default(now())

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  recurrings   RecurringTransaction[]
  budget       Budget?

  @@unique([userId, name])
  @@index([userId])
}

/// Une opération (revenu ou dépense). Montant stocké en centimes (entier).
model Transaction {
  id          String          @id @default(cuid())
  type        TransactionType @default(EXPENSE)
  amountCents Int // ex: 12,50 € => 1250 ; 5000 F CFA => 500000
  note        String          @default("")
  date        DateTime        @default(now())
  userId      String
  categoryId  String?
  accountId   String?
  createdAt   DateTime        @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  account  Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([userId, type])
  @@index([categoryId])
  @@index([accountId])
}

/// Opération récurrente (Premium) : modèle qui génère automatiquement des
/// opérations réelles à intervalle régulier (loyer, salaire, abonnements…).
model RecurringTransaction {
  id          String              @id @default(cuid())
  type        TransactionType     @default(EXPENSE)
  amountCents Int
  note        String              @default("")
  frequency   RecurrenceFrequency @default(MONTHLY)
  nextRunAt   DateTime // prochaine date de génération
  startDate   DateTime            @default(now())
  active      Boolean             @default(true)
  userId      String
  categoryId  String?
  accountId   String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  account  Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([nextRunAt])
}

/// Budget mensuel optionnel pour une catégorie (plafond de dépenses).
model Budget {
  id          String   @id @default(cuid())
  amountCents Int // plafond mensuel en centimes
  userId      String
  categoryId  String   @unique // un seul budget par catégorie
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId])
}
