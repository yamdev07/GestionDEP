# Copie ce fichier en `.env` et adapte les valeurs.

# --- Base de données ---
# Mot de passe PostgreSQL. OBLIGATOIRE en production : ne laisse pas la valeur par défaut.
DB_PASSWORD="change-moi"

# Chaîne de connexion (utile seulement en local HORS Docker).
# En Docker, elle est construite automatiquement à partir de DB_PASSWORD.
DATABASE_URL="postgresql://gestion:gestion@localhost:5432/gestion_depenses?schema=public"

# --- Authentification ---
# Génère un secret avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="change-moi"

# URL publique de l'app.
#   - En local :      http://localhost:3000
#   - En production : construite automatiquement à partir de DOMAIN (https://DOMAIN)
AUTH_URL="http://localhost:3000"

# --- Production uniquement (docker-compose.prod.yml) ---
# Nom de domaine pointant vers ton serveur. Caddy obtient le certificat HTTPS tout seul.
DOMAIN="depenses.mondomaine.com"

# --- Variante derrière un proxy existant (docker-compose.proxy.yml) ---
# Port local sur lequel l'app écoute (127.0.0.1:APP_PORT). À changer si 3000 est déjà pris.
APP_PORT="3000"

# --- Admin global ---
# Email du compte administrateur (accès à /admin). Ce compte doit exister (inscris-toi avec).
# Laisse vide pour désactiver l'administration.
ADMIN_EMAIL=""

# --- Paiement FedaPay (abonnements) ---
# Clé secrète API (sk_sandbox_... en test, sk_live_... en production)
FEDAPAY_SECRET_KEY=""
# Environnement : "sandbox" (test) ou "live" (production)
FEDAPAY_ENVIRONMENT="sandbox"
# Secret du webhook (wh_sandbox... / wh_live...) pour vérifier les notifications de paiement
FEDAPAY_WEBHOOK_SECRET=""

# --- Notifications push (alertes de budget) ---
# Génère une paire de clés avec :
#   npx web-push generate-vapid-keys
# Sans ces clés, les notifications push sont simplement désactivées.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Identité du serveur push : une adresse mailto: ou l'URL du site.
VAPID_SUBJECT="mailto:admin@mondomaine.com"

# Secret protégeant l'endpoint cron d'évaluation des alertes.
# Appel : curl -H "Authorization: Bearer $CRON_SECRET" https://<domaine>/api/cron/budget-alerts
CRON_SECRET=""
