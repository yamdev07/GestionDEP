# Copie ce fichier en `.env` et adapte les valeurs.

# Chaîne de connexion PostgreSQL
DATABASE_URL="postgresql://gestion:gestion@localhost:5432/gestion_depenses?schema=public"

# Génère un secret avec :  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="change-moi"

# URL publique de l'app (ex: https://depenses.mondomaine.com en production)
AUTH_URL="http://localhost:3000"
